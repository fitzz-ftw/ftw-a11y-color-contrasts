{
  "entryPoints": ["../src/**/*.js"],
  "entryPointStrategy": "expand",
  "out": "../docs/publicapi",
  "exclude":["../src/**/*.test.js", "../src/**/*.browser-test.js"],
  "tsconfig": "./tsconfig.public.json",
  "gitRemote": "origin",
  "sourceLinkTemplate": "https://github.com/fitzz-ftw/ftw-a11y-color-contrasts/blob/{gitRevision}/{path}#L{line}",
  "readme": "../README.md",
  "plugin": [
    "typedoc-plugin-missing-exports",
    "typedoc-plugin-coverage",
    "../scripts/typedoc-plugin-smart-docs.js"
  ],
  "logLevel":"Info",
  "excludeTestMembers": true,
  "excludeTestMembersVerbose": false,
  "forceExportAll": false,
  "forceExportAllVerbose": false,
  "placeInternalsInOwningModule":true,
  "excludePrivateClassFields": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "excludeInternal": true, 
  "jsDocCompatibility": {
    "exampleTag": true,
    "defaultTag": true,
    "inheritDocTag": true,
    "ignoreUnescapedBraces": true
}
}
