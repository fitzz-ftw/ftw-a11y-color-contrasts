{
  "entryPoints": ["../src/**/*.js"],
  "entryPointStrategy": "expand",
  "out": "../docs/api",
  "exclude": [
    "../src/**/*.test.js",
    "../src/**/*.browser-test.js"
  ],
  "tsconfig": "./tsconfig.json",
  "gitRemote": "local",
  "readme": "../README.md",
  "plugin": [
    "typedoc-plugin-missing-exports",
    "typedoc-plugin-coverage",
    "../scripts/typedoc-plugin-smart-docs.js"
  ],
  "logLevel": "Info",
  "excludeTestMembers": false,
  "excludeTestMembersVerbose": false,
  "forceExportAll": true,
  "forceExportAllVerbose": true,
  "placeInternalsInOwningModule":true,
  "excludePrivateClassFields": false,
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeExternals": true,
  "jsDocCompatibility": {
    "exampleTag": true,
    "defaultTag": true,
    "inheritDocTag": true,
    "ignoreUnescapedBraces": true
}
}
// typedoc-comments