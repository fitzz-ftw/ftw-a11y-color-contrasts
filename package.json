{
  "name": "@fitzz-ftw/a11y-color-contrasts",
  "version": "1.0.1",
  "main": "./dist/a11y-color-contrasts.umd.cjs",
  "module": "./dist/a11y-color-contrasts.js",
  "exports": {
    ".": {
      "import": "./dist/a11y-color-contrasts.js",
      "require": "./dist/a11y-color-contrasts.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.mjs ",
    "build": "vite --config config/vite.config.mjs build",
    "test": "vitest --config config/vite.config.mjs ",
    "test:run": "vitest --config config/vite.config.mjs run ",
    "test:coverage": "vitest --config config/vite.config.mjs  run --coverage ",
    "lint": "eslint --config config/.eslintrc.js src/**/*.js",
    "format": "prettier --config config/prettier.config.js --write src/**/*.js",
    "docs": "typedoc --options config/typedoc.json",
    "docs:coverage": "typedoc --options config/typedoc.json",
    "docs:public": "typedoc --options config/typedoc.public.json",
    "docs:json": "typedoc --options config/typedoc.json --json docs/debug-out.json --pretty"
  },
  "keywords": [
    "web-components",
    "accessibility",
    "wcag",
    "color-contrast",
    "hsl"
  ],
  "author": "Fitzz TeXnik Welt <FitzzTeXnikWelt@t-online.de>",
  "license": "ISC",
  "description": "A lightweight, framework-agnostic web component library for selecting WCAG-compliant accessible color pairs",
  "homepage": "https://fitzz-ftw.github.io/a11y-color-contrasts/",
  "repository": {
    "type": "git",
    "url": "https://github.com/fitzz-ftw/a11y-color-contrasts"
  },
  "bugs": {
    "url": "https://github.com/fitzz-ftw/a11y-color-contrasts/issues"
  },
  "peerDependencies": {
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@types/culori": "^4.0.1",
    "@vitejs/devtools": "^0.7.6",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "culori": "^4.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "unplugin-preprocessor-directives": "^1.2.0",
    "vite": "^8.3.0",
    "vite-plugin-inspect": "^12.0.2",
    "vitest": "^5.0.1"
  },
  "devserver": {
    "port": 8001,
    "host": "192.168.178.21",
    "root_dir": ".",
    "watch_dirs": [
      "docssrc/"
    ]
  }
}